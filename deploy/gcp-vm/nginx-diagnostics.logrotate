/var/log/nextstop/nginx-errors.jsonl {
    daily
    maxsize 10M
    rotate 7
    maxage 7
    missingok
    notifempty
    compress
    delaycompress
    create 0640 www-data adm
    sharedscripts
    postrotate
        if [ -s /run/nginx.pid ]; then
            /bin/kill -USR1 "$(cat /run/nginx.pid)"
        fi
    endscript
}

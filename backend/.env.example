DATABASE_URL=postgresql://nextstop_app:replace-me@127.0.0.1:5432/nextstop
AUTH_DATABASE_URL=postgresql://nextstop_auth:replace-me@127.0.0.1:5432/nextstop
SNAPSHOT_SIGNING_KEY=replace-with-at-least-32-random-bytes
# Shared by the search API and the separate authentication service.
SEARCH_ACCESS_TOKEN_SIGNING_KEY=replace-with-at-least-32-random-bytes
# Physical-device App Attest stays unavailable while the exact full App ID is blank.
# Obtain the external App ID prefix from Apple; do not infer it from the Team ID.
APP_ATTEST_APP_ID=
# Also gates assertions from development keys registered while this was enabled.
APP_ATTEST_ALLOW_DEVELOPMENT=false
# Comma-separated CFBundleVersion allowlist without whitespace.
APP_ATTEST_SUPPORTED_BUNDLE_VERSIONS=1
# Temporary private-staging compatibility only. Keep false for new environments.
ALLOW_LEGACY_STAGING_BEARER=false
# Read only when the legacy flag is true; never embed this value in a new app build.
SEARCH_API_BEARER_TOKEN=replace-with-at-least-32-random-bytes
HOST=127.0.0.1
# The search API uses 3000; override PORT=3001 for the separate auth service.
PORT=3000
OSM_INGESTION_ENABLED=true
OSM_GEOFABRIK_PBF_URLS=https://download.geofabrik.de/europe/germany-latest.osm.pbf,https://download.geofabrik.de/europe/switzerland-latest.osm.pbf
OSM_CACHE_DIRECTORY=

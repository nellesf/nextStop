{
  "name": "nextstop-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:migrate": "tsx src/persistence/migrate.ts",
    "import:bnetza": "tsx src/jobs/import-bundesnetzagentur.ts",
    "refresh:providers": "tsx src/jobs/refresh-providers.ts",
    "refresh:osm": "tsx src/jobs/refresh-food-pois.ts",
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "lint": "eslint . --max-warnings 0",
    "start": "node dist/src/server.js",
    "start:auth": "node dist/src/auth-server.js",
    "start:worker": "node dist/src/worker.js",
    "test": "node --import tsx --test tests/unit/**/*.test.ts ../ios/SimulatorAuthBroker/*.test.mjs",
    "test:integration": "node --import tsx --test tests/integration/**/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "cbor": "10.0.12",
    "csv-parse": "^7.0.2",
    "fastify": "5.12.0",
    "node-app-attest": "1.0.1",
    "osm-pbf-parser-node": "1.1.4",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@types/pg": "^8.21.0",
    "eslint": "10.8.1",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
